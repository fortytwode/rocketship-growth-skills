# Copy this template to .env and add your Gemini API key.
GEMINI_API_KEY=
# Leave GEMINI_MODEL blank to use the default (gemini-3.5-flash). If your key cannot
# call it, the scripts try gemini-flash-latest, then gemini-2.5-flash.
GEMINI_MODEL=
# Optional: per-request time limit in seconds (default 600).
# GEMINI_TIMEOUT_SECONDS=600
